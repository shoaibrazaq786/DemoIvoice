@model VendorViewModel
@{ ViewData["Title"] = "Add Vendor"; }
<div class="card"><div class="card-header">Add Vendor</div><div class="card-body">
<form asp-action="Create" method="post"><div class="row g-3">
<div class="col-md-6"><label asp-for="VendorName" class="form-label"></label><input asp-for="VendorName" class="form-control" /></div>
<div class="col-md-6"><label asp-for="DefaultSalesTaxRate" class="form-label">Default Sales Tax %</label><input asp-for="DefaultSalesTaxRate" class="form-control" /></div>
<div class="col-md-6"><label asp-for="NTN" class="form-label"></label><input asp-for="NTN" class="form-control" /></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
<div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control"></textarea></div>
</div><div class="mt-4"><button type="submit" class="btn btn-primary">Save</button></div></form></div></div>
