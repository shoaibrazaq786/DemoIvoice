@model IEnumerable<Vendor>
@{ ViewData["Title"] = "Vendors"; }
<div class="d-flex justify-content-between mb-4">
    <h4><i class="fas fa-truck"></i> Vendors</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Add Vendor</a>
</div>
<div class="card"><div class="card-body">
<table class="table table-striped data-table">
<thead><tr><th>Code</th><th>Name</th><th>NTN</th><th>Tax Rate</th><th>Actions</th></tr></thead>
<tbody>@foreach (var v in Model) {
<tr><td>@v.VendorCode</td><td>@v.VendorName</td><td>@v.NTN</td><td>@v.DefaultSalesTaxRate%</td>
<td><button class="btn btn-sm btn-danger" onclick="PakERP.confirmDelete('/Vendors/Delete', @v.Id)"><i class="fas fa-trash"></i></button></td></tr>} 
</tbody></table></div></div>
@section Scripts { <script>PakERP.initDataTable('.data-table');</script> }
