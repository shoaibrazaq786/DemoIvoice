@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between mb-4">
    <h4><i class="fas fa-users"></i> Customers</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Add Customer</a>
</div>
<div class="card"><div class="card-body">
<table class="table table-striped data-table">
<thead><tr><th>Buyer ID</th><th>Name</th><th>NTN</th><th>Province</th><th>Type</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var c in Model) {
<tr>
<td>@c.BuyerId</td><td>@c.BuyerName</td><td>@c.NTN</td><td>@c.Province?.Name</td><td>@c.CustomerType</td>
<td>
<a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-light"><i class="fas fa-edit"></i></a>
<a asp-action="Ledger" asp-route-id="@c.Id" class="btn btn-sm btn-outline-light"><i class="fas fa-book"></i></a>
<button class="btn btn-sm btn-danger delete-btn" data-id="@c.Id" onclick="PakERP.confirmDelete('/Customers/Delete', @c.Id)"><i class="fas fa-trash"></i></button>
</td></tr>}
</tbody></table></div></div>
@section Scripts { <script>PakERP.initDataTable('.data-table');</script> }
