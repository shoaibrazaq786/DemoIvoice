@inject ICompanyContextService CompanyContext
@{
    var companies = await CompanyContext.GetUserCompaniesAsync();
    var currentCompany = await CompanyContext.GetCurrentCompanyAsync();
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pak Accounting ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar">
        <div class="sidebar-brand">
            <h4><i class="fas fa-calculator"></i> Pak ERP</h4>
            <small>FBR Digital Invoicing</small>
        </div>
        <nav class="sidebar-nav">
            <div class="sidebar-section">Main</div>
            <a class="nav-link" href="/"><i class="fas fa-home"></i> Dashboard</a>
            <a class="nav-link" href="/Invoices"><i class="fas fa-file-invoice"></i> Create Invoice</a>
            <a class="nav-link" href="/Bills"><i class="fas fa-file-invoice-dollar"></i> Enter Bills</a>

            <div class="sidebar-section">Masters</div>
            <a class="nav-link" href="/Customers"><i class="fas fa-users"></i> Customers</a>
            <a class="nav-link" href="/Vendors"><i class="fas fa-truck"></i> Vendors</a>
            <a class="nav-link" href="/Inventory"><i class="fas fa-boxes"></i> Inventory</a>
            <a class="nav-link" href="/ChartOfAccounts"><i class="fas fa-sitemap"></i> Chart Of Accounts</a>
            <a class="nav-link" href="/TaxSettings"><i class="fas fa-percent"></i> Sales Tax Settings</a>

            <div class="sidebar-section">Finance</div>
            <a class="nav-link" href="/Banking"><i class="fas fa-university"></i> Banking</a>
            <a class="nav-link" href="/BankReconciliation"><i class="fas fa-balance-scale"></i> Bank Reconciliation</a>
            <a class="nav-link" href="/Reports"><i class="fas fa-chart-bar"></i> Reports</a>

            @if (isAdmin)
            {
                <div class="sidebar-section">Administration</div>
                <a class="nav-link" href="/Company"><i class="fas fa-building"></i> Company</a>
                <a class="nav-link" href="/Settings"><i class="fas fa-cog"></i> Settings</a>
                <a class="nav-link" href="/UserManagement"><i class="fas fa-user-shield"></i> User Management</a>
            }
            <a class="nav-link" href="/AuditLogs"><i class="fas fa-history"></i> Audit Logs</a>
        </nav>
    </aside>

    <div class="main-content">
        <header class="top-navbar no-print">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-primary btn-sm d-lg-none" id="sidebarToggle"><i class="fas fa-bars"></i></button>
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="company-switcher">
                    <form asp-controller="Company" asp-action="SwitchCompany" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <select name="companyId" class="form-select form-select-sm" onchange="this.form.submit()">
                            @foreach (var c in companies)
                            {
                                <option value="@c.Id" selected="@(currentCompany?.Id == c.Id)">@c.CompanyName</option>
                            }
                        </select>
                    </form>
                </div>
                <span class="text-muted"><i class="fas fa-user"></i> @User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-sign-out-alt"></i> Logout</button>
                </form>
            </div>
        </header>
        <main class="content-area">
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
