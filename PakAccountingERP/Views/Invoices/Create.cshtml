@model InvoiceViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Invoice" : "Create Invoice";
    var customers = ViewBag.Customers as IEnumerable<Customer>;
    var items = ViewBag.Items as IEnumerable<Item>;
    var units = ViewBag.Units as IEnumerable<UnitOfMeasure>;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="fas fa-file-invoice"></i> @ViewData["Title"]</h4>
    <a href="/Invoices" class="btn btn-outline-light btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <input type="hidden" id="InvoiceId" value="@Model.Id" />

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Buyer *</label>
                <select id="CustomerId" class="form-select">
                    <option value="">Select Customer</option>
                    @foreach (var c in customers!)
                    {
                        <option value="@c.Id" selected="@(Model.CustomerId == c.Id)">@c.BuyerName (@c.BuyerId)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Date</label>
                <input type="date" id="InvoiceDate" class="form-control" value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Invoice Type</label>
                <select id="InvoiceType" class="form-select" asp-items="Html.GetEnumSelectList<InvoiceTypeEnum>()"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Address</label>
                <input type="text" id="BuyerAddress" class="form-control" value="@Model.BuyerAddress" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Province</label>
                <select id="ProvinceId" class="form-select" asp-items="@(new SelectList(ViewBag.Provinces as IEnumerable<Province>, "Id", "Name", Model.ProvinceId))">
                    <option value="">Select</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">NTN / CNIC</label>
                <input type="text" id="BuyerNTN" class="form-control" value="@Model.BuyerNTN" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered invoice-lines" id="invoiceLines">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>HS Code</th>
                        <th>Description</th>
                        <th>Unit</th>
                        <th>Qty</th>
                        <th>Cartons</th>
                        <th>Price</th>
                        <th>Tax %</th>
                        <th>Tax Amt</th>
                        <th>Discount</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lines.Any())
                    {
                        foreach (var line in Model.Lines)
                        {
                            <partial name="_InvoiceLine" model="line" view-data="@(new ViewDataDictionary(ViewData) { {"Items", items}, {"Units", units} })" />
                        }
                    }
                    else
                    {
                        <partial name="_InvoiceLine" model="new InvoiceLineViewModel()" view-data="@(new ViewDataDictionary(ViewData) { {"Items", items}, {"Units", units} })" />
                    }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-outline-light btn-sm mb-4" id="addRow"><i class="fas fa-plus"></i> Add Row</button>

        <div class="row">
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-6"><label class="form-label">Further Tax</label><input type="number" id="FurtherTax" class="form-control" step="0.01" value="@Model.FurtherTax" /></div>
                    <div class="col-6"><label class="form-label">FED</label><input type="number" id="FED" class="form-control" step="0.01" value="@Model.FED" /></div>
                    <div class="col-6"><label class="form-label">Extra Tax</label><input type="number" id="ExtraTax" class="form-control" step="0.01" value="@Model.ExtraTax" /></div>
                    <div class="col-6"><label class="form-label">WHT</label><input type="number" id="WithholdingTax" class="form-control" step="0.01" value="@Model.WithholdingTax" /></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="invoice-totals">
                    <div class="d-flex justify-content-between"><span>Sub Total:</span><span id="SubTotal" class="currency">0.00</span></div>
                    <div class="d-flex justify-content-between"><span>Discount:</span><span id="DiscountAmount" class="currency">0.00</span></div>
                    <div class="d-flex justify-content-between"><span>Tax:</span><span id="TaxAmount" class="currency">0.00</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5 fw-bold"><span>Net Total:</span><span id="NetTotal" class="currency">0.00</span></div>
                    <input type="hidden" id="NetTotalHidden" />
                </div>
            </div>
        </div>

        <div class="mt-4 no-print">
            <button type="button" class="btn btn-primary" id="saveInvoice"><i class="fas fa-save"></i> Save Invoice</button>
            @if (Model.Id > 0)
            {
                <button type="button" class="btn btn-success" id="postInvoice" data-id="@Model.Id"><i class="fas fa-check"></i> Post</button>
                <button type="button" class="btn btn-warning" id="submitFbr" data-id="@Model.Id"><i class="fas fa-paper-plane"></i> Submit to FBR</button>
                <a href="/Invoices/Print/@Model.Id" class="btn btn-outline-light" target="_blank"><i class="fas fa-print"></i> Print</a>
            }
        </div>
    </div>
</div>

<table class="d-none"><tbody id="lineTemplate"><partial name="_InvoiceLine" model="new InvoiceLineViewModel()" view-data="@(new ViewDataDictionary(ViewData) { {"Items", items}, {"Units", units} })" /></tbody></table>

@section Scripts {
<script>
    $(function () {
        $('#invoiceLines tbody tr').each(function () { InvoiceCalc.bindRowEvents(this); });
        InvoiceCalc.calculateTotals();

        $('#CustomerId').on('change', function () {
            const id = $(this).val();
            if (!id) return;
            $.get('/Invoices/GetCustomerDetails/' + id, function (data) {
                $('#BuyerAddress').val(data.address);
                $('#ProvinceId').val(data.provinceId);
                $('#BuyerNTN').val(data.ntn || data.cnic);
            });
        });

        $('#addRow').on('click', InvoiceCalc.addRow);

        $('#FurtherTax, #FED, #ExtraTax, #WithholdingTax').on('input', InvoiceCalc.calculateTotals);

        $('#saveInvoice').on('click', function () {
            const lines = [];
            $('#invoiceLines tbody tr').each(function () {
                lines.push({
                    itemId: parseInt($(this).find('.item-select').val()) || 0,
                    hsCode: $(this).find('.hs-code').val(),
                    productDescription: $(this).find('.description').val(),
                    unitOfMeasureId: parseInt($(this).find('.unit-select').val()) || 0,
                    quantity: parseFloat($(this).find('.qty').val()) || 0,
                    cartons: parseFloat($(this).find('.cartons').val()) || 0,
                    price: parseFloat($(this).find('.price').val()) || 0,
                    taxRate: parseFloat($(this).find('.tax-rate').val()) || 0,
                    discount: parseFloat($(this).find('.discount').val()) || 0
                });
            });

            const data = {
                id: parseInt($('#InvoiceId').val()) || 0,
                customerId: parseInt($('#CustomerId').val()),
                buyerAddress: $('#BuyerAddress').val(),
                provinceId: parseInt($('#ProvinceId').val()) || null,
                buyerNTN: $('#BuyerNTN').val(),
                invoiceDate: $('#InvoiceDate').val(),
                invoiceType: parseInt($('#InvoiceType').val()),
                salesType: 3,
                furtherTax: parseFloat($('#FurtherTax').val()) || 0,
                fed: parseFloat($('#FED').val()) || 0,
                extraTax: parseFloat($('#ExtraTax').val()) || 0,
                withholdingTax: parseFloat($('#WithholdingTax').val()) || 0,
                lines: lines
            };

            PakERP.ajaxPost('/Invoices/Save', data, function (r) {
                PakERP.showToast('Invoice saved: ' + r.data.invoiceNumber);
                if (!data.id) window.location.href = '/Invoices/Edit/' + r.data.id;
            });
        });

        $('#postInvoice').on('click', function () {
            PakERP.ajaxPost('/Invoices/Post?id=' + $(this).data('id'), {}, () => PakERP.showToast('Invoice posted'));
        });

        $('#submitFbr').on('click', function () {
            PakERP.ajaxPost('/Invoices/SubmitFbr?id=' + $(this).data('id'), {}, (r) => PakERP.showToast('FBR: ' + (r.data.fbrInvoiceNumber || 'Submitted')));
        });
    });
</script>
}
